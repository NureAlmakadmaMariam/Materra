# Copy to .env and fill in what you need:  cp .env.example .env
# .env is git-ignored — never commit real secrets.

# Django. SECRET_KEY is required with production settings;
# development settings fall back to a local-only key.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default). For PostgreSQL set
# DB_ENGINE=django.db.backends.postgresql and DB_HOST / DB_PORT / DB_USER / DB_PASSWORD.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Dev admin account created by `python manage.py create_dev_superuser` (DEBUG only).
DJANGO_SUPERUSER_EMAIL=admin@materra.dev
DJANGO_SUPERUSER_PASSWORD=
